<%- include('_top') %>

<p class="muted"><%= reviews.length %> most recent reviews. Delete reviews that are spam or inappropriate.</p>

<section class="card">
  <div class="table-wrap"><table class="table">
    <thead><tr><th><span class="sr-only">Image</span></th><th>Product</th><th>Rating</th><th>Review</th><th>By</th><th>Date</th><th class="right"><span class="sr-only">Actions</span></th></tr></thead>
    <tbody>
      <% reviews.forEach(r => { %>
        <tr>
          <td><img class="thumb" src="<%= r.image %>" alt=""></td>
          <td><a href="/products/<%= r.product_id %>#reviews" target="_blank" rel="noopener"><%= r.product_name %></a></td>
          <td class="nowrap"><span class="stars" style="--r: <%= r.rating %>" role="img" aria-label="<%= r.rating %> out of 5"></span></td>
          <td><%= r.comment || '—' %></td>
          <td><%= r.reviewer_name %><% if (r.user_id) { %> <a href="/admin/customers/<%= r.user_id %>" class="small-link">(account)</a><% } %></td>
          <td class="nowrap"><%= String(r.created_at).slice(0, 10) %></td>
          <td class="right">
            <form action="/admin/reviews/<%= r.id %>/delete" method="post" data-confirm="Delete this review?">
              <button class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
</section>

<%- include('_bottom') %>
