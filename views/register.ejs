<%- include('partials/header') %>

<div class="auth-wrap">
  <form action="/register" method="post" class="card auth-card auth-wide">
    <h1>Create your account</h1>
    <p class="muted">Register to place orders, save your delivery details and track your orders.</p>
    <% if (errors.length) { %>
      <div class="alert alert-error" role="alert"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
    <% } %>
    <div class="form-grid">
      <div class="field span-2">
        <label for="name">Full name</label>
        <input id="name" name="name" value="<%= form.name || '' %>" maxlength="100" autocomplete="name" required>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" value="<%= form.email || '' %>" maxlength="150" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="phone">Phone</label>
        <input id="phone" name="phone" type="tel" value="<%= form.phone || '' %>" placeholder="03XX-XXXXXXX" maxlength="30" autocomplete="tel" required>
      </div>
      <div class="field span-2">
        <label for="address">Address</label>
        <input id="address" name="address" value="<%= form.address || '' %>" maxlength="255" autocomplete="street-address">
      </div>
      <div class="field span-2">
        <label for="city">City</label>
        <input id="city" name="city" value="<%= form.city || '' %>" maxlength="100" autocomplete="address-level2">
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" type="password" name="password" minlength="8" maxlength="128" autocomplete="new-password" aria-describedby="pw-hint" required>
      </div>
      <div class="field">
        <label for="confirm">Confirm password</label>
        <input id="confirm" type="password" name="confirm" minlength="8" maxlength="128" autocomplete="new-password" required>
      </div>
    </div>
    <p class="hint" id="pw-hint">Password: at least 8 characters.</p>
    <button class="btn btn-lg btn-block">Create account</button>
    <p class="center">Already have an account? <a href="/login">Log in</a></p>
  </form>
</div>

<%- include('partials/footer') %>
