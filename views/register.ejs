<%- include('partials/header') %>

<div class="auth-wrap">
  <form action="/register" method="post" class="card auth-card auth-wide">
    <h1>Create your account</h1>
    <p class="muted">Register to place orders, save your delivery details and track your orders.</p>
    <% if (errors.length) { %>
      <div class="alert alert-error"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
    <% } %>
    <div class="form-grid">
      <div class="field span-2">
        <label for="name">Full name</label>
        <input id="name" name="name" value="<%= form.name || '' %>" required>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" value="<%= form.email || '' %>" required>
      </div>
      <div class="field">
        <label for="phone">Phone</label>
        <input id="phone" name="phone" value="<%= form.phone || '' %>" placeholder="03XX-XXXXXXX" required>
      </div>
      <div class="field span-2">
        <label for="address">Address</label>
        <input id="address" name="address" value="<%= form.address || '' %>">
      </div>
      <div class="field">
        <label for="city">City</label>
        <input id="city" name="city" value="<%= form.city || '' %>">
      </div>
      <div class="field"></div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" type="password" name="password" minlength="6" required>
      </div>
      <div class="field">
        <label for="confirm">Confirm password</label>
        <input id="confirm" type="password" name="confirm" minlength="6" required>
      </div>
    </div>
    <button class="btn btn-lg btn-block">Create account</button>
    <p class="center">Already have an account? <a href="/login">Log in</a></p>
  </form>
</div>

<%- include('partials/footer') %>
