{
  "name": "haven-goods",
  "version": "1.0.0",
  "description": "Haven Goods - e-commerce website for a local business (Node.js, Express, EJS, SQLite)",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node --no-warnings server.js",
