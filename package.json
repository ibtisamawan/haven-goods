{
  "name": "haven-goods",
  "version": "1.0.0",
  "description": "Haven Goods - e-commerce website for a local business (Node.js, Express, EJS, SQLite)",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node --no-warnings server.js",
    "reset-db": "node --no-warnings scripts/reset-db.js",
    "screenshots": "node --no-warnings scripts/screenshots.js",
    "report": "node scripts/build-report.js",
    "lint": "eslint .",
    "check": "node --no-warnings scripts/check.js",
    "test": "node --no-warnings scripts/screenshots.js",
    "audit:browser": "node --no-warnings scripts/browser-audit.js",
    "test:security": "node --no-warnings scripts/security-check.js",
    "build": "npm run lint && npm run check"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "dependencies": {
    "cookie-session": "^2.1.1",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "marked": "^12.0.2",
    "puppeteer-core": "^25.18.1"
  }
}
